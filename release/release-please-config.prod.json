{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"last-release-sha": "0b9e8947e3cd1064e66ed919e624f8505270a2e1",
	"packages": {
		"packages/nft-models": {
			"package-name": "nft-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/nft-connector-iota": {
			"package-name": "nft-connector-iota",
			"changelog-path": "docs/changelog.md"
		},
		"packages/nft-connector-entity-storage": {
			"package-name": "nft-connector-entity-storage",
			"changelog-path": "docs/changelog.md"
		},
		"packages/nft-service": {
			"package-name": "nft-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/nft-rest-client": {
			"package-name": "nft-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"apps/nft-cli": {
			"package-name": "nft-cli",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"nft-models",
				"nft-connector-iota",
				"nft-connector-entity-storage",
				"nft-service",
				"nft-rest-client",
				"nft-cli"
			]
		}
	]
}
