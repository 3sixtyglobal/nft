{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"**/scripts/**",
		"**/contracts/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"autorelease",
		"bech",
		"Faucet",
		"hotfixes",
		"iotaledger",
		"TWIN",
		"nameof",
		"Stiftung",
		"utxo",
		"devnet",
		"Stdlib"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/tst1.*/",
		"/^```(.|\\s)*?```\\s*$/gm"
	]
}
