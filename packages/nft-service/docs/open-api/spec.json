	"components": {
		"schemas": {
			"Error": {
				"description": "Model to describe serialized error.",
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "The name for the error."
					},
					"message": {
						"type": "string",
						"description": "The message for the error as an i18n key."
					},
					"source": {
						"type": "string",
						"description": "The source of the error."
					},
					"properties": {
						"type": "object",
						"additionalProperties": {},
						"description": "Any additional information for the error."
					},
					"stack": {
						"type": "string",
						"description": "The stack trace for the error."
					},
					"cause": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [
					"name",
					"message"
				]
			},
			"NftMintRequest": {
				"type": "object",
				"properties": {
					"tag": {
						"type": "string",
						"description": "The tag for the NFT."
					},
					"immutableMetadata": {
						"description": "The immutable metadata for the NFT."
					},
					"metadata": {
						"description": "The metadata for the NFT."
					},
					"namespace": {
						"type": "string",
						"description": "The namespace of the connector to use for the NFT, defaults to component configured namespace."
					}
				},
				"required": [
					"tag"
				],
				"description": "The request body containing minting parameters."
			},
			"NftResolveResponse": {
				"type": "object",
				"properties": {
					"issuer": {
						"type": "string",
						"description": "The issuer of the NFT."
					},
					"issuerIdentityId": {
						"type": "string",
						"description": "The on-chain Object ID of the verified IOTA Identity that minted this NFT.\nEmpty string when not minted with identity verification."
					},
					"tag": {
						"type": "string",
						"description": "The tag data for the NFT."
					},
					"immutableMetadata": {
						"description": "The immutable data for the NFT."
					},
					"metadata": {
						"description": "The metadata for the NFT."
					}
				},
				"required": [
					"issuer",
					"issuerIdentityId",
					"tag"
				],
				"description": "The resolved NFT data."
			},
			"NftTransferRequest": {
				"type": "object",
				"properties": {
					"recipientAddress": {
						"type": "string",
						"description": "The recipient address for the NFT."
					},
					"metadata": {
						"description": "The metadata for the NFT."
					}
				},
				"required": [
					"recipientAddress"
				],
				"description": "The request body containing transfer parameters."
			},
			"NftUpdateRequest": {
				"type": "object",
				"properties": {
					"metadata": {
						"description": "The metadata for the NFT."
					}
				},
				"description": "The request body containing update parameters."
			}
		},
		"securitySchemes": {
			"jwtBearerAuthScheme": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	}
