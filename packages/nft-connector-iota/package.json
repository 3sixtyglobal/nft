{
	"name": "@twin.org/nft-connector-iota",
	"version": "0.0.2-next.4",
	"description": "Implementation of the NFT connector using Iota",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/nft.git",
		"directory": "packages/nft-connector-iota"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build:contracts": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/mainnet.env",
		"build:contracts:testnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/testnet.env",
		"build:contracts:devnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/devnet.env",
		"deploy:testnet": "move-to-json deploy --load-env configs/testnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"deploy:devnet": "move-to-json deploy --load-env configs/devnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"deploy:mainnet": "move-to-json deploy --load-env configs/mainnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"build:deploy:testnet": "npm run build:contracts:testnet && npm run deploy:testnet",
		"build:deploy:devnet": "npm run build:contracts:devnet && npm run deploy:devnet",
		"build:deploy:mainnet": "npm run build:contracts && npm run deploy:mainnet",
		"build": "tsc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run test:build && npm run test && npm run bundle && npm run docs",
		"dist:devnet": "npm run clean && npm run build && npm run build:deploy:devnet && npm run test && npm run bundle && npm run docs",
		"dist:mainnet": "npm run clean && npm run build && npm run build:deploy:mainnet && npm run test && npm run bundle && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run bundle && npm run docs",
		"prepare": "ts-patch install -s"
	},
	"dependencies": {
		"@iota/bcs": "1.2.0",
		"@iota/iota-sdk": "1.6.1",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/dlt-iota": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/nft-models": "0.0.2-next.4",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-models": "next"
	},
	"devDependencies": {
		"@rollup/plugin-json": "6.1.0",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/move-to-json": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/wallet-connector-iota": "next",
		"@types/node": "24.3.0",
		"@vitest/coverage-v8": "3.2.4",
		"copyfiles": "2.4.1",
		"dotenv": "17.2.1",
		"rimraf": "6.0.1",
		"rollup": "4.49.0",
		"rollup-plugin-copy": "3.5.0",
		"ts-patch": "3.3.0",
		"nodemon": "3.1.10",
		"typedoc": "0.28.11",
		"typedoc-plugin-markdown": "4.8.1",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"files": [
		"dist/cjs",
		"dist/esm",
		"dist/types",
		"locales",
		"docs"
	]
}
