{
	"name": "@twin.org/nft-connector-iota",
	"version": "0.0.3-next.3",
	"description": "IOTA-backed NFT connector for network operations and on-ledger state.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/nft.git",
		"directory": "packages/nft-connector-iota"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"contracts:build:testnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/testnet.env",
		"contracts:build:devnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/devnet.env",
		"contracts:build:mainnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smart-contract-deployments/smart-contract-deployments.json --load-env configs/mainnet.env",
		"contracts:deploy:testnet": "move-to-json deploy --load-env configs/testnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"contracts:deploy:devnet": "move-to-json deploy --load-env configs/devnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"contracts:deploy:mainnet": "move-to-json deploy --load-env configs/mainnet.env --contracts src/contracts/smart-contract-deployments/smart-contract-deployments.json",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@iota/bcs": "1.5.0",
		"@iota/iota-sdk": "1.11.0",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/dlt-iota": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/nft-models": "0.0.3-next.3",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-models": "next"
	},
	"devDependencies": {
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/move-to-json": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/wallet-connector-iota": "next",
		"@types/node": "25.3.3",
		"@vitest/coverage-v8": "4.0.18",
		"copyfiles": "2.4.1",
		"dotenv": "17.3.1",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"nodemon": "3.1.14",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"nft",
		"tokens",
		"non-fungible",
		"assets",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/nft/issues"
	},
	"homepage": "https://twindev.org"
}
